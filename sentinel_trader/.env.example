# =====================================================================
# Sentinel-Trader Configuration Environment Template
# =====================================================================

# Binance API Credentials
# Get Testnet keys at: https://testnet.binance.vision/
BINANCE_API_KEY=replace_with_testnet_api_key
BINANCE_API_SECRET=replace_with_testnet_api_secret

# SAFETY INVARIANT: Default strictly to Binance Testnet Sandbox
BINANCE_SANDBOX=True

# HARD SAFETY LOCK: Must be explicitly True to disable sandbox mode
ALLOW_PRODUCTION_TRADING=False

# LLM Configuration for AI Sentinel (gemini, openai, or mock)
LLM_PROVIDER=gemini
LLM_API_KEY=replace_with_llm_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Target Trading Pair
TARGET_SYMBOL=SOL/USDT

# Risk Mitigation Engine Thresholds
TAKE_PROFIT_PCT=0.10     # +10% Take Profit
STOP_LOSS_PCT=0.04       # -4% Stop Loss
PANIC_SELL_CONFIDENCE_THRESHOLD=0.70  # Minimum AI confidence to trigger panic sell

# Mainnet Edge Case Protections
LIQUIDATION_ORDER_TYPE=limit_ioc      # 'limit_ioc' (slippage bounded) or 'market'
MAX_LIQUIDATION_SLIPPAGE_PCT=0.02     # 2% max slippage limit against best bid
FEE_BUFFER_PCT=0.001                  # 0.1% buffer against fee erosion in base asset

# Polling Intervals (Seconds)
POLL_INTERVAL_SECONDS=3.0
NEWS_POLL_INTERVAL_SECONDS=5.0

# Optional: Initial Position Entry Price (Leave blank to capture current market price at launch)
# ENTRY_PRICE=145.50

# Simulation & Testing Controls
MOCK_EXCHANGE=False
ENABLE_SIMULATED_NEWS=True
